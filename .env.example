# Database connection
# Local SQLite (default):
DATABASE_URL="file:./dev.db"

# Or Cloud PostgreSQL (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/ecogen_ai?sslmode=require"

# JWT Secret for Session Management
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# OpenRouter AI API (Optional - built-in expert fallback engine runs if empty)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
